# ╔══════════════════════════════════════════════════════════════╗
# ║  ryasai-auth — Standalone Auth Agent                        ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy to .env and edit:  cp .env.example .env

# ── Server Connection ────────────────────────────────────────
# URL of your ryasai server
SERVER_URL=http://localhost:3456

# Admin key (must match RYASAI_ADMIN_KEY on the server)
SERVER_ADMIN_KEY=

# ── Providers ────────────────────────────────────────────────
# Comma-separated list of providers to login
# Available: kiro, codebuddy, wavespeed, canva, yepapi
PROVIDERS=kiro,codebuddy

# ── Worker Identity ──────────────────────────────────────────
# Unique ID for this agent (auto-generated if empty)
WORKER_ID=

# Max concurrent browser login sessions
# PARALLEL=true:  N accounts run simultaneously (fast, higher RAM)
# PARALLEL=false: accounts run 1-by-1 with delay (safe anti-ban)
CONCURRENCY=5

# Enable parallel account processing (true = fast, false = sequential anti-ban)
PARALLEL=true

# ── Anti-Ban / Isolation ─────────────────────────────────────
# Delay (seconds) between accounts (only used when PARALLEL=false)
ACCOUNT_DELAY=5
# Random jitter (0 to N seconds) added to delay for human-like timing
ACCOUNT_DELAY_JITTER=3

# ── Adaptive Throttle ────────────────────────────────────────
# Auto-scale concurrency based on CPU/memory pressure
ADAPTIVE_THROTTLE=true
# CPU % above which concurrency is reduced
CPU_HIGH_WATERMARK=80
# CPU % below which concurrency can increase back
CPU_LOW_WATERMARK=50
# Memory % above which concurrency is hard-throttled
MEM_HIGH_WATERMARK=85
# Stagger delay (seconds) between launching browsers (prevents thundering herd)
STAGGER_DELAY=1.5

# ── Browser ──────────────────────────────────────────────────
# Backend: "camoufox" (Firefox-based, best stealth) or "rod" (Go Chromium, faster)
BROWSER_BACKEND=camoufox

# "true" (native headless), "virtual" (Xvfb — best stealth on Linux), "false" (visible)
CAMOUFOX_HEADLESS=true

# GPU offload for rendering (reduces CPU 40-60% per browser instance)
# "auto" = detect GPU and use if available
# "hardware" = force ANGLE/OpenGL (NVIDIA/AMD/Intel)
# "vulkan" = force Vulkan backend (best perf, needs vulkan-icd)
# "off" = software rendering (swiftshader, max stealth but CPU-heavy)
GPU_MODE=auto

# Proxy for browser sessions (optional)
# PROXY_URL=socks5://user:pass@host:port

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
