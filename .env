# ╔══════════════════════════════════════════════════════════════╗
# ║  ryasai-auth — Standalone Auth Agent                        ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy to .env and edit:  cp .env.example .env

# ── Server Connection ────────────────────────────────────────
# URL of your ryasai server
SERVER_URL=http://43.134.80.130:3456

# Admin key (must match RYASAI_ADMIN_KEY on the server)
SERVER_ADMIN_KEY=zRTQoAln7BMZbmGVC8Ra0UJ2ZZJxVElOYCua4eFmFto

# ── Providers ────────────────────────────────────────────────
# Comma-separated list of providers to login
# Available: kiro, codebuddy, wavespeed, canva, yepapi
PROVIDERS=kiro

# ── Worker Identity ──────────────────────────────────────────
# Unique ID for this agent (auto-generated if empty)
WORKER_ID=

# Max concurrent browser login sessions
CONCURRENCY=3

# ── Browser ──────────────────────────────────────────────────
# Enable real Camoufox browser login (MUST be true for actual auth)
BATCHER_ENABLE_CAMOUFOX=true

# "true" (native headless), "virtual" (Xvfb — best stealth on Linux), "false" (visible)
CAMOUFOX_HEADLESS=virtual

# Proxy for browser sessions (optional)
# PROXY_URL=socks5://user:pass@host:port

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
